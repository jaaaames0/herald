def read_response(tweet_id):
    """Return a parsed-shape tweet dict for the given id.

    Order of precedence:
      1. If id starts with 'FAIL_' (failure fixture) → emit a not-found
         error so callers can exercise the failed-fetch path.
      2. If id is in QUOTE_CHAIN → return the fixture.
      3. Otherwise → emit a generic stub so the parser succeeds. This keeps
         real-world id fixtures in test_tweets.json working without
         hand-maintaining mocks for every id.
    """
    s = str(tweet_id)
    if s.startswith("FAIL_"):
        sys.stderr.write("mock_bird: forced-failure read id: " + s + "\n")
        sys.exit(3)
    if s in QUOTE_CHAIN:
        return QUOTE_CHAIN[s]
    return {
        "id": s,
        "text": "[mocked read of " + s + "]",
        "createdAt": "Thu Jul 02 23:10:00 +0000 2026",
        "conversationId": "9999999999999",
        "author": {"username": "mockuser", "name": "Mock User"},
        "authorId": "111",
        "_raw": {"legacy": {"id_str": s}},
    }


args = sys.argv[1:]
