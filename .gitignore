# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/

# Herald runtime artefacts
*.db
*.db-journal
*.db-wal
*.db-shm

# Intermediate pipeline outputs (regenerated by collect/parse)
/unified.json
